{
  "name": "ledgerflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:api": "pnpm --dir backend dev",
    "build": "next build",
    "build:web": "next build",
    "build:api": "pnpm --dir backend build",
    "build:all": "pnpm build:web && pnpm build:api",
    "start": "next start",
    "lint": "tsc --noEmit",
    "migrate": "pnpm --dir backend migrate"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.3"
  }
}
